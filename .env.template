# ===========================================
# Bob The Agent Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values

# -----------------------------------------
# Agent Configuration
# -----------------------------------------
# Log level: debug, info, warn, error
LOG_LEVEL=info
APP_BASE_PATH=/app

# Anthropic Configuration (cloud fallback)
# ANTHROPIC_API_KEY=your-api-key-here

# OpenAI Configuration (cloud fallback)
# OPENAI_API_KEY=your-api-key-here

# -----------------------------------------
# x.AI (Grok) Configuration
# -----------------------------------------
# API key for X.com (Twitter) search via Grok API; use a separate key from the main XAI key
# to isolate web-search costs; this USER_-prefixed name is what compose.yaml passes to the
# container (SearXNG handles general web search).
# USER_XAI_SEARCH_API_KEY=your-xai-search-api-key-here

# Main x.AI API key (optional, for other Grok features)
# Legacy/compat: still accepted internally as a fallback by the x-com and grok-search skills,
# but compose.yaml passes USER_-prefixed names instead; not required for the default stack.
# XAI_API_KEY=your-xai-api-key-here

# API key for direct X.com (Twitter) API search; compose.yaml passes this name to the container.
# USER_X_COM_API_TOKEN=your-x-com-token

# -----------------------------------------
# Discord Bot Configuration
# -----------------------------------------
# Get your bot token from https://discord.com/developers/applications
# DISCORD_BOT_TOKEN=your-discord-bot-token-here
# Legacy name, no longer referenced by installed Hermes (unverified)
# DISCORD_CLIENT_ID=your-discord-client-id

# -----------------------------------------
# AWS
# -----------------------------------------
# USER_AWS_S3_ACCESS_KEY_ID=your-aws-key
# USER_AWS_S3_SECRET_ACCESS_KEY=your-aws-secret
# -----------------------------------------
# Email notifications via Amazon SES
# -----------------------------------------
# Legacy name; compose.yaml only passes the USER_AWS_S3_* variables (no separate SES wiring).
# AWS_REGION=us-east-1
# NOTIFICATION_EMAIL=your-email@example.com
# -----------------------------------------
# AWS_S3 Configuration
# -----------------------------------------
# USER_AWS_S3_BUCKET=your-bucket
# USER_AWS_S3_REGION=eu-central-1

# -----------------------------------------
# SearXNG Configuration
# -----------------------------------------
# Secret key for SearXNG instance (generate a random string)
# Legacy: not consumed by compose.yaml (the SearXNG service manages its own settings).
# SEARXNG_SECRET_KEY=your-random-secret-key-here
# Image pin used by compose.yaml by default (override only with a deliberate reason).
# SEARXNG_VERSION=2026.4.29-cba0cffa8
SEARXNG_BASE_URL=http://searxng:8888